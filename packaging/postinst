#!/bin/sh
# Mirrors dh_installsystemd: enable state is preserved, a stopped service stays stopped,
# and an upgrade restarts only after the configuration validates.
set -e

case "$1" in
configure)
    if ! getent passwd caddy >/dev/null; then
        adduser --system --group --home /var/lib/caddy --shell /usr/sbin/nologin caddy
    fi
    usermod -aG www-data caddy
    install -d -o caddy -g caddy -m 0750 /var/lib/caddy
    # was-enabled is true without a state file, so a first install enables; an upgrade keeps a disabled unit disabled.
    deb-systemd-helper unmask caddy.service >/dev/null || true
    if deb-systemd-helper --quiet was-enabled caddy.service; then
        deb-systemd-helper enable caddy.service >/dev/null || true
    else
        deb-systemd-helper update-state caddy.service >/dev/null || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        if /usr/bin/caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
            if [ -z "$2" ]; then
                deb-systemd-invoke start caddy.service ||
                    echo "xcaddy: not started (ports in use?); enabled for the next boot" >&2
            else
                deb-systemd-invoke try-restart caddy.service || true
            fi
        else
            echo "xcaddy: configuration invalid; the running service was left untouched" >&2
        fi
    fi
    ;;
esac
exit 0
